{
  "name": "replaykit-tracker",
  "version": "1.0.0",
  "description": "Session replay tracker for Next.js apps",
  "author": "Arnon Danon",
  "license": "MIT",
  "type": "module",
  "main": "./dist/replaykit-tracker.cjs.js",
  "module": "./dist/replaykit-tracker.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/replaykit-tracker.es.js",
      "require": "./dist/replaykit-tracker.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --noEmit false",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.5.4"
  }
}
