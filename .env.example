# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password

# ─── JWT signing secret (min 32 characters) ───────────────────
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# ─── Shared key sent by tracker in X-Api-Key header ───────────
TRACKER_API_KEY=change_me_tracker_key

# ─── Session retention (days) ─────────────────────────────────
RETENTION_DAYS=7

# ─── Initial admin password (change after first login) ────────
ADMIN_PASSWORD=admin123

# ─── CORS — URL(s) of your Next.js app(s) ─────────────────────
# Local dev default — change to your app's URL in production
ALLOWED_ORIGIN_0=http://localhost:3000
# ALLOWED_ORIGIN_1=https://myapp.internal

# ─── HA standby only ──────────────────────────────────────────
# PRIMARY_HOST=192.168.1.10
# REPLICATION_PASSWORD=change_me_replication_password
